From d849a148eb592eb590063208fbf6b9ec5d87e3ca Mon Sep 17 00:00:00 2001
From: vignesh-chaturvedi <vigneshchaturvedi@gmail.com>
Date: Mon, 26 Oct 2026 23:45:03 +0530
Subject: [PATCH] libc-test: Skip `getexecpath` before OpenBSD 8.0

`getexecpath` was added in OpenBSD 8.0, so the 7.9 headers do not
declare it and the generated C test fails to compile there.

Link: https://www.openbsd.org/80.html
Assisted-by: LLM
---
 libc-test/build/main.rs | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/libc-test/build/main.rs b/libc-test/build/main.rs
index 6209e4d6f..1a14dcdd2 100755
--- a/libc-test/build/main.rs
+++ b/libc-test/build/main.rs
@@ -401,6 +401,7 @@ fn test_openbsd(t: &Target) {
     cfg.flag("-Wno-deprecated-declarations");
 
     let x86_64 = t.x86_64();
+    let openbsd = VERSIONS.openbsd.unwrap();
 
     headers!(
         cfg,
@@ -542,6 +543,15 @@ fn test_openbsd(t: &Target) {
         }
     });
 
+    cfg.skip_fn(move |func| {
+        match func.ident() {
+            // Added in OpenBSD 8.0
+            "getexecpath" => openbsd < (8, 0),
+
+            _ => false,
+        }
+    });
+
     cfg.rename_struct_ty(|ty| ty.ends_with("_t").then_some(ty.to_string()));
     cfg.rename_union_ty(|ty| ty.ends_with("_t").then_some(ty.to_string()));
 
-- 
2.51.0

